[Unit]
Description=City Runner activity and city indexing worker
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=cityrunner
Group=cityrunner
WorkingDirectory=/opt/city-runner
EnvironmentFile=/etc/city-runner/backend.env
ExecStart=/opt/city-runner/.venv/bin/python -m backend.app.worker --poll-seconds 1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
