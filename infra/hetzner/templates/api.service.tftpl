[Unit]
Description=City Runner API
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service
RequiresMountsFor=${journal_mount}

[Service]
Type=simple
User=cityrunner
Group=cityrunner
WorkingDirectory=/opt/city-runner
EnvironmentFile=/etc/city-runner/backend.env
ExecStartPre=/usr/bin/mountpoint -q ${journal_mount}
ExecStartPre=/opt/city-runner/.venv/bin/python -m backend.app.account_data --restore
ExecStart=/opt/city-runner/.venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
